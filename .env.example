

# --- Base de datos MySQL ---
DB_ENDPOINT=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=despachos_db
DB_USERNAME=admin
DB_PASSWORD=changeme_secure_password

# --- Backend Despachos (puerto 8081) ---
# Usado por Spring Boot para construir el datasource URL

# --- AWS General ---
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# --- ECR: registros de imágenes ---
ECR_REPO_FRONTEND=innovatech/frontend-despacho
ECR_REPO_BACKEND=innovatech/backend-despacho

# --- EC2: IPs de las instancias ---
EC2_FRONTEND_HOST=0.0.0.0   # IP pública de la instancia frontend
EC2_BACKEND_HOST=10.0.1.x   # IP privada de la instancia backend