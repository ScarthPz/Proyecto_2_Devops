# Variables de entorno para docker-compose (entorno local)
# Copia este archivo como ".env" y completa los valores reales.
# ".env" NO se sube al repositorio (ver .gitignore).

# --- MySQL (entorno local con docker-compose) ---
MYSQL_ROOT_PASSWORD=changeme_secure_password
MYSQL_DATABASE_VENTAS=ventas_db
MYSQL_DATABASE_DESPACHOS=despachos_db

# Nota: las credenciales de AWS (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_SESSION_TOKEN) NO van aquí. Se configuran como GitHub Secrets
# (ver secrets.yml) porque solo las usa el pipeline de CI/CD, nunca
# el entorno local.
