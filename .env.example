# ============================================================
# INNOVATECH CHILE — Variables de entorno
# Copia como .env y completa los valores. NUNCA subas .env.
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme_secure_password
MYSQL_DATABASE_VENTAS=ventas_db
MYSQL_DATABASE_DESPACHOS=despachos_db

# --- AWS General ---
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# --- ECR: registros de imágenes ---
ECR_REPO_FRONTEND=innovatech/frontend-despacho
ECR_REPO_BACKEND_DESPACHOS=innovatech/backend-despachos
ECR_REPO_BACKEND_VENTAS=innovatech/backend-ventas

# --- EC2: acceso SSH ---
EC2_FRONTEND_HOST=0.0.0.0
EC2_BACKEND_HOST=10.0.1.x